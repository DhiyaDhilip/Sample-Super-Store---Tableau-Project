        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='color' value='#000000' />
          <format attr='font-weight' value='bold' />
          <format attr='background-color' value='#e6e6e6' />
          <format attr='width' value='566' />
        </style-rule>
        <style-rule element='story-title'>
          <format attr='text-align' value='center' />
          <format attr='color' value='#333333' />
          <format attr='border-width' value='2' />
          <format attr='border-style' value='solid' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98244' id='1' param='vert' removable='false' type-v2='layout-flow' w='99034' x='483' y='878'>
            <zone h='4610' id='3' type-v2='title' w='99034' x='483' y='878' />
            <zone fixed-size='170' h='18661' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99034' x='483' y='5488' />
            <zone h='74973' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99034' x='483' y='24149'>
              <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Super Store Data overview of sales performance' captured-sheet='Profit by Region' id='4' />
                  <story-point caption='Region-wise profit analysis, The West region generated the highest profit of $93,600 and The East region follows with a profit of $84,646 and The Central region recorded a profit of $39,372 and The south region recorded a profit of $37,582.' captured-sheet='Profit by Region' id='5' />
                  <story-point caption='Geo-Spatial Profit Analysis: Philadelphia records the lowest profit at -12,327, while New York City leads with the highest profit of 57,478.' captured-sheet='Geo-Location' id='6'>
                    <capturedDeltas>
                      <worksheet name='Geo-Location'>
                        <filter class='quantitative' column='[federated.0krwwnx02vztp21f8d7f01qygqvc].[sum:Profit:qk]' included-values='in-range-or-null'>
                          <min>16481.0</min>
                          <max>57478.0</max>
                        </filter>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.0krwwnx02vztp21f8d7f01qygqvc].[Latitude (generated)]' field-type='quantitative' max='16359718.457060369' min='-8130933.7359027099' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.0krwwnx02vztp21f8d7f01qygqvc].[Longitude (generated)]' field-type='quantitative' max='-4074284.3352743182' min='-17873970.374116205' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Category-Wise Performance Analysis: The Technology category leads with the highest profit of 134,263 and sales of 713,298.The Furniture category has the lowest profit of 14,397 and also records the lowest sales of 612,941.' captured-sheet='Category by Profit,Quantity and Sales' id='7' />
                  <story-point caption='Yearly Discount Trends: Discounts saw a sharp rise from 96.3 in 2014 to a peak of 517.7 in 2017 before experiencing a drastic drop to just 7.6 in 2018. ' captured-sheet='Discount by Ship Date' id='8' />
                  <story-point caption='Sales by sub-category, with two groups:&#10;&#10;Orange bars (YES) indicate categories that exceed the 120,000 sales threshold.&#10;Blue bars (NO) represent categories below this threshold.&#10;The dashed red line represents the 120,000 sales parameter.' captured-sheet='Calculated Field Parameter by Sales' id='9' />
                  <story-point caption='Profit by Sub-Category, divided into In and Out categories.&#10;&#10;In (Dark Blue) → Sub-categories with higher profit&#10;Out (Light Blue) → Sub-categories with lower profit or losses.' captured-sheet='Sets by Sales' id='10' />
                  <story-point caption='Overall Performance Metrics:&#10;Total Sales: 1,966,848&#10;Total Profit: 255,200&#10;Total Quantity: 32,684&#10;Total Discount: 1,349&#10;' captured-sheet='Sample Super Store Data' id='11' />
                  <story-point caption='Highest Performing Category:&#10;Category: Technology&#10;Sub-Category with Highest Sales: Phones (Sales: 281,264)&#10;Profit Contribution: High&#10;Reason: Technology products, especially Phones, generate high revenue and profit margins.' captured-sheet='Sample Super Store Data' id='12' />
                  <story-point caption='Lowest Performing Category:&#10;Category: Office Supplies&#10;Sub-Category with Lowest Sales: Supplies (Sales: 32,816)&#10;Profit Contribution: Low&#10;Reason: Office supplies generally have low margins, and discounting affects profits.' captured-sheet='Sample Super Store Data' id='13' />
                  <story-point caption='Regional Performance:&#10;Highest Profit Region: East (93,600)&#10;Lowest Profit Region: South (37,582)' captured-sheet='Sample Super Store Data' id='14' />
                  <story-point caption='Conclusion:&#10;1) Technology (especially Phones) is the best-performing category – companies should focus on increasing stock and marketing.&#10;2) Office Supplies, especially Supplies sub-category, needs improvement – reducing discounts and better pricing strategies might help.&#10;3) East Region is the most profitable – businesses can expand operations there.&#10;4) South Region has the lowest profit – a targeted strategy is required to improve sales and profitability.' captured-sheet='Sample Super Store Data' id='15' />
                  <story-point caption='End' captured-sheet='Sample Super Store Data' id='16'>
                    <capturedDeltas>
                      <worksheet name='Discount by Ship Date'>
                        <filter class='categorical' column='[federated.0krwwnx02vztp21f8d7f01qygqvc].[Action (Sub-Category)]'>
